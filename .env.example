# Supabase (public browser keys)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_or_anon_key"
SUPABASE_URL="https://your_project_id.supabase.co"

# Supabase Service Role (server-only, never add a VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Cashfree Payment Gateway
# Credentials from https://merchant.cashfree.com -> Developers -> API Keys
CASHFREE_ENVIRONMENT="sandbox"
CASHFREE_APP_ID="your_app_id"
CASHFREE_SECRET_KEY="your_secret_key"
CASHFREE_WEBHOOK_URL=""

# Public Cashfree mode flag exposed to the browser SDK
VITE_CASHFREE_ENVIRONMENT="sandbox"
